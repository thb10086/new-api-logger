# ===================================================================
# LLM Logger - 开发环境示例 (docker compose up 使用)
# 生产环境请复制 .env.prod.example
#
# 使用:
#   cp .env.example .env
#   # 按需修改下列变量
#   docker compose up -d
# ===================================================================

# ===================================================================
# Gateway 上游 (newapi) 连接方式 - 三种模式二选一
# ===================================================================
# [模式 1 - 默认] newapi 端口不变 (如 3000), gateway 通过宿主机网络连接:
LLMLOG_UPSTREAM_URL=http://host.docker.internal:3000
#
# [模式 2] newapi 与本项目共享 network (推荐生产使用, 更安全):
# LLMLOG_UPSTREAM_URL=http://newapi:3000
# 并在 docker-compose.yml 的 gateway.networks 下添加 newapi 所在网络,
# 或把本 compose 与 newapi compose 合并部署.
#
# [模式 3] Gateway 共享宿主机网络 (特殊场景):
# LLMLOG_UPSTREAM_URL=http://localhost:3000
# 并在 docker-compose.yml 开启 gateway 的 `network_mode: host`
# ===================================================================

LLMLOG_UPSTREAM_TIMEOUT=600s
LLMLOG_MAX_BODY_BYTES=104857600
LLMLOG_COS_OFFLOAD_THRESHOLD=32768
LLMLOG_CAPTURE_BUFFER=10000
LLMLOG_CAPTURE_WORKERS=4
LLMLOG_CH_BATCH_SIZE=200
LLMLOG_CH_BATCH_INTERVAL=500ms
LLMLOG_LOG_LEVEL=info

# -------------------- ClickHouse --------------------
# 开发用 default 用户无密码, 生产环境 .env.prod.example 必须设置
LLMLOG_CH_DATABASE=llm_logger
LLMLOG_CH_USER=default
LLMLOG_CH_PASSWORD=

# -------------------- 对象存储 (本地 MinIO) --------------------
LLMLOG_S3_BUCKET=llm-logs
LLMLOG_S3_ACCESS_KEY=minioadmin
LLMLOG_S3_SECRET_KEY=minioadmin

# -------------------- Query API --------------------
# 面板 + API 统一的鉴权 token, 首次登录时填入 UI
LLMLOG_API_TOKEN=dev-token-change-me
LLMLOG_API_CORS_ORIGINS=*

# -------------------- Admin UI --------------------
# 浏览器访问端口: http://<server-ip>:${ADMIN_UI_PORT}
ADMIN_UI_PORT=8888
# 前端 /api 反代目标 (默认同 compose 内 query-api, 不要改)
LLMLOG_ADMIN_API_BASE=/api

# -------------------- 对外暴露端口 --------------------
# Gateway 代理端口 (客户端/Caddy 连接此端口)
# 用户通过此端口访问, gateway 全量透传到 newapi 并记录 LLM 请求
GATEWAY_PORT=8080
GATEWAY_METRICS_PORT=9090

# ClickHouse / MinIO 端口 (开发调试用, 生产环境建议勿公网暴露)
CH_HTTP_PORT=8123
CH_TCP_PORT=9000
MINIO_API_PORT=9100
MINIO_CONSOLE_PORT=9001
