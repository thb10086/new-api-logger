<?xml version="1.0"?>
<!--
  默认开启 async_insert: 让 CH 自己聚合小批写入,
  Gateway 直接 HTTP POST JSONEachRow 即可获得高吞吐.

  - async_insert=1                    开启异步聚合
  - wait_for_async_insert=0           不等待真正落盘 (代理层只关心已收, 不关心已写)
  - async_insert_max_data_size=10MB   缓冲达 10MB 触发刷写
  - async_insert_busy_timeout_ms=500  最多等 500ms 触发刷写
-->
<clickhouse>
    <profiles>
        <default>
            <async_insert>1</async_insert>
            <wait_for_async_insert>0</wait_for_async_insert>
            <async_insert_max_data_size>10485760</async_insert_max_data_size>
            <async_insert_busy_timeout_ms>500</async_insert_busy_timeout_ms>
            <async_insert_max_query_number>10000</async_insert_max_query_number>

            <!-- 写入相关 -->
            <max_insert_block_size>1048576</max_insert_block_size>
            <max_insert_threads>8</max_insert_threads>

            <!-- HTTP 接口大请求 (允许单次提交大批量 JSON) -->
            <http_max_request_param_data_size>104857600</http_max_request_param_data_size>
        </default>
    </profiles>
</clickhouse>
