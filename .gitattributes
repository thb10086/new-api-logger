# ============================================================
# LLM Logger - git 行尾规范
# 仓库要部署到 Linux 容器, 所有文本文件统一 LF
# Windows 本地 checkout 时由 core.autocrlf 决定, 不影响
# ============================================================

# 默认: 所有文本文件按 LF 存储
* text=auto eol=lf

# 必须强制 LF 的 (Linux 会执行)
*.sh       text eol=lf
*.bash     text eol=lf
Dockerfile text eol=lf
Makefile   text eol=lf
*.yml      text eol=lf
*.yaml     text eol=lf
*.conf     text eol=lf

# Windows only 批处理保留 CRLF
*.ps1      text eol=crlf
*.bat      text eol=crlf
*.cmd      text eol=crlf

# 源码一律 LF
*.go       text eol=lf
*.py       text eol=lf
*.ts       text eol=lf
*.tsx      text eol=lf
*.js       text eol=lf
*.jsx      text eol=lf
*.json     text eol=lf
*.md       text eol=lf
*.sql      text eol=lf
*.toml     text eol=lf
*.xml      text eol=lf
*.html     text eol=lf
*.css      text eol=lf

# 二进制, 不处理
*.png      binary
*.jpg      binary
*.jpeg     binary
*.gif      binary
*.ico      binary
*.pdf      binary
*.zip      binary
*.tar      binary
*.gz       binary
*.woff     binary
*.woff2    binary
