# ===================================================================
# LLM Logger - 生产环境配置示例
#
# 使用:
#   cp .env.prod.example .env
#   # 必须修改所有 *CHANGE_ME* 的密码字段!
#   # 建议 openssl rand -hex 32 生成强随机字符串
#   docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d
# ===================================================================

# ===================================================================
# [必改] Gateway 上游 newapi 地址
# ===================================================================
# 推荐模式: newapi 与本 compose 共享 network, 用 hostname
LLMLOG_UPSTREAM_URL=http://newapi:3000
LLMLOG_UPSTREAM_TIMEOUT=600s

# ===================================================================
# [必改] 所有密码字段
# ===================================================================

# ClickHouse 管理员密码 (用 openssl rand -hex 32 生成)
LLMLOG_CH_DATABASE=llm_logger
LLMLOG_CH_USER=default
LLMLOG_CH_PASSWORD=CHANGE_ME_openssl_rand_hex_32

# MinIO 凭证 (或替换为腾讯 COS / AWS S3, 见下方)
LLMLOG_S3_BUCKET=llm-logs
LLMLOG_S3_ACCESS_KEY=CHANGE_ME_minio_access_key
LLMLOG_S3_SECRET_KEY=CHANGE_ME_minio_secret_key_at_least_40_chars

# Admin UI 登录 token (用 openssl rand -hex 32 生成)
LLMLOG_API_TOKEN=CHANGE_ME_openssl_rand_hex_32

# ===================================================================
# Admin UI - 面板对外暴露配置
# ===================================================================
# 对外端口 (建议通过 Nginx/Caddy 加 TLS 后再挂公网)
ADMIN_UI_PORT=28888
LLMLOG_ADMIN_API_BASE=/api

# CORS - 生产应限定在 Admin UI 的域名
LLMLOG_API_CORS_ORIGINS=https://admin.yourdomain.com

# ===================================================================
# 性能调优 (10k+ QPS 推荐值)
# ===================================================================
LLMLOG_MAX_BODY_BYTES=104857600
LLMLOG_COS_OFFLOAD_THRESHOLD=32768
LLMLOG_CAPTURE_BUFFER=20000
LLMLOG_CAPTURE_WORKERS=16
LLMLOG_CH_BATCH_SIZE=500
LLMLOG_CH_BATCH_INTERVAL=300ms
LLMLOG_LOG_LEVEL=info

# ===================================================================
# 容器资源限制 (按服务器规格调整)
# ===================================================================
CH_CPU_LIMIT=4
CH_MEM_LIMIT=6g
GATEWAY_CPU_LIMIT=2
GATEWAY_MEM_LIMIT=1g

# ===================================================================
# 端口配置 (选用 28xxx / 29xxx 段, 避开常见服务占用)
# 生产环境 CH/MinIO/Metrics 由 prod yml 绑 127.0.0.1, 不对外
# ===================================================================
# 对外端口 (外部 LLM 客户端 / 运维访问)
GATEWAY_PORT=28080              # LLM 代理入口, 对外, 客户端 base_url 指向这里
ADMIN_UI_PORT=28888             # 管理面板 (建议配 Nginx + TLS)

# 内部端口 (生产只绑 127.0.0.1)
GATEWAY_METRICS_PORT=29090      # Prometheus 抓取指标
CH_HTTP_PORT=28123              # ClickHouse HTTP (migration 用)
CH_TCP_PORT=29000               # ClickHouse Native TCP
MINIO_API_PORT=29100            # MinIO S3 API
MINIO_CONSOLE_PORT=29001        # MinIO Web Console
QUERY_API_PORT=28000            # Query API (admin-ui 内部反代, 默认不对外)

# ===================================================================
# [可选] 用腾讯云 COS 替代 MinIO (推荐)
# 注释掉 MinIO 服务, 或保留 MinIO 只做开发测试
# ===================================================================
# 把下面解注释, 并删除 docker-compose 的 minio 服务
# LLMLOG_S3_ENDPOINT=https://cos.ap-guangzhou.myqcloud.com
# LLMLOG_S3_REGION=ap-guangzhou
# LLMLOG_S3_BUCKET=llm-logs-1234567890
# LLMLOG_S3_ACCESS_KEY=AKIDxxxxxxxxxxxx
# LLMLOG_S3_SECRET_KEY=xxxxxxxxxxxxxx
# LLMLOG_S3_USE_PATH_STYLE=false
